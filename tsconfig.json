{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src"],
  "exclude": ["node_modules", "**/*.test.ts"],
  "compilerOptions": {
    // Environment
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",

    // Type Checking
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,

    // Output
    "target": "esnext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true
  }
}
