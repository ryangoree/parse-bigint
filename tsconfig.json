{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src"],
  "compilerOptions": {
    // Environment
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,

    // Type Checking
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,

    // Output
    "noEmit": true
  }
}
