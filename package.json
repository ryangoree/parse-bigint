{
  "name": "parse-bigint",
  "version": "1.0.2",
  "description": "Parses a number-like value into a BigInt with support for scientific notation, underscores, commas, and base prefixes.",
  "license": "GPL-3.0-only",
  "author": "ryan goree (https://github.com/ryangoree)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangoree/parse-bigint.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "watch": "npm run build --watch",
    "test": "node --test src/**",
    "test:watch": "node --test --watch src/**",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/node": "^24.0.10",
    "typescript": "^5.5.4"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
